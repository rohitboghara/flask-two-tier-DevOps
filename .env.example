# .env - Environment variables for the Flask application

# Flask Configuration
FLASK_SECRET_KEY='a-very-secret-key-that-you-should-change'
FLASK_DEBUG=True
FLASK_HOST='0.0.0.0'
FLASK_PORT=5000

# PostgreSQL Database Configuration
DB_HOST='postgres'
DB_NAME='userdb'
DB_USER='postgres'
DB_PASSWORD='postgres'
DB_PORT=5432

DEBUG_METRICS=1
